# ============================================================
# NemesisAI - Self-Hosted Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ==================== REQUIRED ==============================

# Session secret for cookie encryption (generate a random 64-char string)
# Example: openssl rand -hex 32
SESSION_SECRET=

# OpenAI API key for AI code generation and voice transcription
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ==================== DATABASE ==============================
# These are used by docker-compose to create the PostgreSQL container.
# The app auto-constructs DATABASE_URL from these values.

POSTGRES_USER=nemesis
POSTGRES_PASSWORD=change_me_to_a_secure_password
POSTGRES_DB=nemesisai
# POSTGRES_PORT=5432

# If running PostgreSQL externally (not via docker-compose),
# set DATABASE_URL directly instead:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ==================== OPTIONAL ==============================

# Your domain name (used for Stripe webhook URLs and HTTPS)
# APP_DOMAIN=yourdomain.com

# Stripe payment processing (leave empty to disable payments)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Admin and premium user email whitelists (comma-separated)
# SUPERADMIN_EMAILS=admin@example.com
# PREMIUM_EMAILS=premium@example.com

# ==================== ADVANCED ==============================

# Force a specific port (default: 5000)
# PORT=5000

# App version identifier (auto-set by deploy.sh from git SHA)
# APP_VERSION=dev

# ==================== ANDROID APK BUILD =====================
# Only needed when building Android APK wrapper via Capacitor.
# CAP_SERVER_URL should point to your live HTTPS deployment.
# CAP_SERVER_URL=https://nemesis.example.com
# CAP_APP_ID=com.nemesisai.creator
# CAP_APP_NAME=NemesisAI
